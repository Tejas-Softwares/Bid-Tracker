# Copy this file to .env and fill in values.
# Production on Vercel: set these under Settings → Environment Variables, then redeploy.
# Local `npm run dev` does not need DATABASE_URL; it uses an in-process database.
#
# VERCEL is set automatically on the platform (used to treat requests as HTTPS).
# Do not add it yourself.

# Neon Postgres connection string (required in production).
# This project reads tejas_database_neon_DATABASE_URL first (Vercel Neon integration name),
# then DATABASE_URL, then POSTGRES_URL.
tejas_database_neon_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=
POSTGRES_URL=

# Secret used to create the first admin and to recover a locked-out admin.
# Pick a long random string. Local `npm run dev` defaults to "dev-setup".
SETUP_CODE=

# Secret Vercel sends as Authorization: Bearer … when running /api/cron-backup.
# Use 20+ random letters and numbers. Local `npm run dev` defaults to "dev-cron".
CRON_SECRET=

# --- Local development only (scripts/dev-server.mjs) ---

# HTTP port. Defaults to 3000.
PORT=3000

# Where the local PGlite database is stored.
# Omit to use .dev-data/ in the project folder.
# Set to "memory" for a fresh database each run (used by tests).
# DEV_DATA=memory

# --- Tests only (tests/app.test.mjs); optional ---

# Path to the Excel workbook used by import tests. Falls back to a CI path if unset.
# XLSX=

# Log /api requests during tests.
# DEBUG_REQ=1

# Log auth cookie details during tests.
# DEBUG_AUTH=1

# Print the local server log if a test fails.
# SHOW_LOG=1
